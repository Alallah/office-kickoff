<?xml version="1.0" encoding="utf-8"?>
<!--
  Office Kickoff on IIS (in-process hosting; needs the .NET 10 Hosting Bundle).

  Two settings cannot be made here and MUST be set on the server:

  1. All game state lives in memory. The application pool must run a single worker process
     (Maximum Worker Processes = 1, i.e. no web garden), with Regular Time Interval (periodic
     recycle) = 0, Idle Time-out = 0 and Disable Overlapped Recycle = True. Otherwise rooms and
     matches vanish when the pool recycles or idles, or are split between processes.

  2. IIS on desktop editions of Windows limits simultaneous requests (10 on Pro, 3 on Home) and
     every open game tab holds one for its live connection. Host on Windows Server, or on a
     desktop machine run the published app directly under Kestrel instead of IIS
     (set ASPNETCORE_URLS=http://0.0.0.0:5000, then run: dotnet OfficeKickoff.Web.dll).

  There is deliberately no <webSocket> element: where the IIS WebSocket Protocol feature is not
  installed that section is unknown and the whole site would fail with a configuration error.
  Install the feature for the best latency; without it SignalR falls back to Server-Sent Events
  or long polling by itself.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\OfficeKickoff.Web.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
