@{
    ViewData["Title"] = "Something went wrong";
    ViewData["BodyClass"] = "page-error";
}

@section Styles {
    <style>
        .error-page {
            min-height: 100%;
            display: grid;
            place-items: center;
            padding: 24px 16px;
            background: radial-gradient(ellipse at 50% 0%, var(--surface-2), var(--bg) 70%);
        }

        .error-card {
            max-width: 460px;
            width: 100%;
            padding: 32px 28px;
            border-radius: var(--radius-l);
            background: var(--glass);
            border: 1px solid var(--line);
            box-shadow: var(--shadow);
            text-align: center;
        }

        .error-card h1 {
            margin: 0 0 12px;
            font-size: 44px;
            color: var(--accent);
        }

        .error-card p {
            margin: 0 0 24px;
            color: var(--text-dim);
        }

        .error-card a {
            display: inline-block;
            padding: 12px 22px;
            border-radius: var(--radius);
            background: var(--accent);
            color: var(--accent-ink);
            font-family: var(--font-display);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            text-decoration: none;
        }

        .error-card a:focus-visible {
            outline: 3px solid var(--accent-2);
            outline-offset: 3px;
        }
    </style>
}

<main class="error-page">
    <div class="error-card" role="alert">
        <h1 class="display">Off the post</h1>
        <p>Something went wrong on the server. Head back to the start and kick off again.</p>
        <a href="@Url.Content("~/")">Back to the start</a>
    </div>
</main>
